# --- Server ---
PORT=3000

# --- Storage ---
# Leave empty to run with the in-memory store (great for demos and tests).
MONGODB_URI=

# --- WhatsApp Cloud API (Meta) ---
# Leave WHATSAPP_TOKEN empty to run in "dry-run" mode: replies are logged, not sent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me
# App secret used to verify the X-Hub-Signature-256 header. Strongly recommended in production.
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0

# --- OpenAI ---
# Leave empty to use the built-in rule-based NLU (demo mode).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Business rules ---
BUSINESS_TIMEZONE=Africa/Cairo
# Days use Luxon weekday numbers: 1 = Monday ... 7 = Sunday
BUSINESS_DAYS=1,2,3,4,5
BUSINESS_OPEN=09:00
BUSINESS_CLOSE=17:00
MIN_LEAD_MINUTES=60
BOOKING_HORIZON_DAYS=14
