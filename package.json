{
  "name": "whatsapp-booking-bot",
  "version": "1.0.0",
  "description": "WhatsApp appointment-booking chatbot backend: Express, TypeScript, MongoDB, OpenAI function calling.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "chat": "tsx scripts/chat.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "luxon": "^3.7.2",
    "mongoose": "^9.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.10",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
